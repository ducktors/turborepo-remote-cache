{
  "name": "turborepo-remote-cache",
  "version": "3.0.3",
  "description": "Turborepo remote cache server",
  "main": "./dist/app.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/app.js",
      "require": "./dist/app.js"
    },
    "./aws-lambda": {
      "import": "./dist/aws-lambda.js",
      "require": "./dist/aws-lambda.js"
    },
    "./package.json": "./package.json"
  },
  "author": "Maksim Sinik <maksim@sinik.it>",
  "license": "MIT",
  "bin": {
    "turborepo-remote-cache": "./dist/cli.js"
  },
  "scripts": {
    "build": "pnpm lint && rimraf ./dist && tsc -p ./tsconfig.json",
    "build:docker": "tsc -p ./tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "biome check src test",
    "lint:fix": "biome check --apply src test",
    "fmt": "biome format src test",
    "dev": "run-p dev:start check:types",
    "dev:start": "tsx watch --inspect --env-file=.env src/index.ts",
    "check:types": "tsc -p ./tsconfig.json --noEmit",
    "test": "tsx --test ./test/*.ts",
    "test:watch": "tsx --watch --test ./test/*.ts",
    "test:coverage": "c8 --all --src src --reporter lcov --reporter text tsx --test ./test/*.ts",
    "commitlint": "commitlint",
    "semantic-release": "semantic-release",
    "commit": "npx git-cz",
    "deps:update": "pnpm dlx taze -r -I -i -u",
    "deps:inspector": "pnpx node-modules-inspector",
    "socket:test": "socket fix --test",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ducktors/turborepo-remote-cache.git"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/lib-storage": "^3.1156.0",
    "@azure/storage-blob": "^12.34.0",
    "@fastify/aws-lambda": "^5.1.4",
    "@fastify/jwt": "10.2.5",
    "@google-cloud/storage": "^7.22.0",
    "@hapi/boom": "10.0.1",
    "@sinclair/typebox": "0.25.25",
    "ajv": "8.20.0",
    "close-with-grace": "1.3.0",
    "env-schema": "5.2.1",
    "fastify": "5.12.7",
    "fastify-jwt-jwks": "^3.1.2",
    "fastify-plugin": "5.1.0",
    "fs-blob-store": "6.0.0",
    "hyperid": "3.3.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.2.2",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/prompt": "^20.5.3",
    "@ducktors/tsconfig": "^1.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.20.5",
    "@types/s3rver": "^3.7.4",
    "c8": "^9.1.0",
    "commitizen": "^4.3.2",
    "commitlint-config-cz": "^0.13.3",
    "commitlint-plugin-function-rules": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "fastify-tsconfig": "^3.0.0",
    "husky": "^9.1.7",
    "mock-jwks": "^3.3.5",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "s3rver": "^3.7.1",
    "semantic-release": "^25.0.9",
    "socket": "^0.15.64",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "bugs": {
    "url": "https://github.com/ducktors/turborepo-remote-cache/issues"
  },
  "homepage": "https://github.com/ducktors/turborepo-remote-cache#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "turborepo",
    "monorepo",
    "remote",
    "cache"
  ],
  "files": [
    "api",
    "dist",
    "vercel.json"
  ],
  "packageManager": "pnpm@10.33.0"
}
